# ── Stripe — WG Coins checkout ───────────────────────────────────────────────
# Copy this file to `.env` and fill in real values (`.env` is gitignored).
# On Replit/hosted deployments set these as secrets/shared env vars instead of
# committing a file.
#
# Test mode and live mode are two independent sets of values. When you switch,
# replace BOTH values below together: a live key paired with a test-mode signing
# secret (or the other way round) makes every delivery fail signature
# verification, so paid purchases stop crediting coins. The mode the running
# process actually sees is reported by GET /api/webhooks/stripe.

# Secret key used by the API server to create Checkout Sessions. Server-side
# only — never expose it to the browser or the Vite build.
# Test mode: sk_test_…    Live mode: sk_live_…
STRIPE_SECRET_KEY=sk_test_replace_me

# Signing secret of the /api/webhooks/stripe endpoint IN THE SAME MODE as the
# key above. Stripe Dashboard → Developers → Webhooks → <your endpoint> →
# Signing secret. Test and live endpoints each have their own secret.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Publishable key, exposed to the Vite build as `import.meta.env.VITE_*`.
# NOT READ by any code today: /buy-coins uses hosted Checkout (redirect), which
# needs no browser-side Stripe key. Only required if you later switch to
# embedded Checkout or Stripe Elements.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
