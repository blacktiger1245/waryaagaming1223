# ── Stripe — WG Coins checkout ───────────────────────────────────────────────
# Copy this file to `.env` and fill in real values (`.env` is gitignored).
# On Replit/hosted deployments set these as secrets/shared env vars instead of
# committing a file.

# Secret key used by the API server to create Checkout Sessions. Server-side
# only — never expose it to the browser or the Vite build.
STRIPE_SECRET_KEY=sk_test_replace_me

# Signing secret for the /api/webhooks/stripe endpoint.
# Stripe Dashboard → Developers → Webhooks → <your endpoint> → Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Publishable key, exposed to the Vite build as `import.meta.env.VITE_*`.
# The hosted Checkout redirect flow (used by /buy-coins) never needs it in the
# browser — it is only required if you later switch to embedded Checkout or
# Stripe Elements.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
